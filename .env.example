# ============================================================
# Detailing Marin — Variables de entorno
# Copiá este archivo como .env.local y completá los valores
# NUNCA subas .env.local al repositorio
# ============================================================

# WhatsApp — Número de contacto (sin + ni espacios)
# Ejemplo: 56954451422 para +56 9 5445 1422
NEXT_PUBLIC_WHATSAPP_NUMBER=56xxxxxxxxx

# SMTP — Configuración de correo para el formulario de contacto
# Para Gmail, generá una App Password en:
# https://myaccount.google.com/apppasswords
# (Requiere 2FA activado en la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Correo de destino donde llegan las reservas
CONTACT_EMAIL=tu-correo@gmail.com

# Google Search Console — token de verificación (meta tag)
# Se obtiene en Search Console > Configuración > Verificación de propiedad
GOOGLE_SITE_VERIFICATION=tu-token-de-google-site-verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Directus — base URL (do not include /admin) and read-only API token
# DIRECTUS_URL=https://directus.example.com
# DIRECTUS_TOKEN=your-read-only-api-token
# DIRECTUS_ADMIN_TOKEN=your-restricted-cms-write-token
# DIRECTUS_MEDIA_FOLDER_ID=directus-folder-uuid-for-this-site

# Admin authentication — use the transaction pooler at runtime (for Vercel/serverless)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Prisma CLI migrations use the direct endpoint and the checked-in Supabase root CA
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-root-ca.crt
# ADMIN_SEED_PASSWORD=replace-with-a-private-password
